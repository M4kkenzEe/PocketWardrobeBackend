# =============================================================================
# PocketWardrobe Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and replace placeholder values with your actual configuration
# NEVER commit .env file to git!

# -----------------------------------------------------------------------------
# JWT Configuration
# IMPORTANT: JWT_SECRET must be at least 32 characters long
# Generate a secure random secret: openssl rand -base64 32
# -----------------------------------------------------------------------------
JWT_SECRET=your-super-secure-jwt-secret-key-minimum-32-characters-required-change-in-production
JWT_ISSUER=https://pocketwardrobe.com
JWT_AUDIENCE=pocketwardrobe-users

# -----------------------------------------------------------------------------
# Database Configuration
# IMPORTANT: Never use empty password in production
# Create strong password: openssl rand -base64 24
# -----------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432
DB_DRIVER=org.postgresql.Driver
DB_USER=postgres
DB_PASSWORD=your_secure_database_password_change_in_production
DB_NAME=wardrobe

# -----------------------------------------------------------------------------
# Server Configuration
# Use HTTPS in production with proper SSL certificates
# -----------------------------------------------------------------------------
SERVER_HOST=localhost
SERVER_PORT=8080
SERVER_SCHEME=http  # Change to 'https' in production

# -----------------------------------------------------------------------------
# App Deep Link Configuration (for mobile app)
# -----------------------------------------------------------------------------
APP_SCHEME=pocketwardrobe
APP_HOST=share

# -----------------------------------------------------------------------------
# External Services
# Update these URLs based on your deployment
# -----------------------------------------------------------------------------
REMOVE_BG_SERVICE_URL=http://localhost:8000/
ANALYSIS_SERVICE_URL=http://localhost:8088/
# Docker: use service name. Local: use localhost
LOOK_GENERATION_SERVICE_URL=http://recommendation:8001

# -----------------------------------------------------------------------------
# File Storage
# These directories will be created automatically
# -----------------------------------------------------------------------------
UPLOADS_DIRECTORY=uploads
LOOKS_DIRECTORY=looks

# -----------------------------------------------------------------------------
# CORS Configuration
# For development: use '*' to allow all origins
# For production: specify exact origins (comma-separated)
# Example: https://app.pocketwardrobe.com,https://admin.pocketwardrobe.com
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=*

# -----------------------------------------------------------------------------
# Rate Limiting
# Limits requests per minute to prevent abuse
# Auth: login/register endpoints (IP-based)
# Upload: file upload endpoints (user-based)
# Default: all other authenticated endpoints (user-based)
# -----------------------------------------------------------------------------
RATE_LIMIT_AUTH=10
RATE_LIMIT_UPLOAD=20
RATE_LIMIT_DEFAULT=100

# -----------------------------------------------------------------------------
# Database Connection Pool (HikariCP)
# Recommended values:
# - Pool size: 5-10 for small apps, 10-20 for medium apps
# - Connection timeout: 30 seconds
# - Idle timeout: 10 minutes
# - Max lifetime: 30 minutes
# -----------------------------------------------------------------------------
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# -----------------------------------------------------------------------------
# File Upload Validation
# Max file size in MB and allowed image types (comma-separated)
# -----------------------------------------------------------------------------
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/jpg

# -----------------------------------------------------------------------------
# Logging Configuration
# Available levels: TRACE, DEBUG, INFO, WARN, ERROR
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# SMTP / Email Configuration
# For Gmail: create an App Password at https://myaccount.google.com/apppasswords
# (requires 2FA enabled on the Google account)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@clothis.tech
SMTP_PASSWORD=your_gmail_app_password_16_chars
SMTP_FROM=PocketWardrobe <noreply@clothis.tech>
