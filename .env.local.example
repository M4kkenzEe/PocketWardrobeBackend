# =============================================================================
# PocketWardrobe — Local Development Environment
# =============================================================================
# Copy to .env.local and run: docker-compose -f docker-compose.local.yml up -d
# All secrets here are dev-only. NEVER use these values in production.

# JWT — any 32+ char string is fine locally
JWT_SECRET=local-dev-jwt-secret-do-not-use-in-production-ever
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=pocketwardrobe-users

# Database — matches docker-compose.local.yml postgres service
DB_URL=jdbc:postgresql://localhost:5432
DB_DRIVER=org.postgresql.Driver
DB_USER=postgres
DB_PASSWORD=devpass
DB_NAME=wardrobe_dev

# Server — local HTTP, no SSL
SERVER_HOST=localhost
SERVER_PORT=8080
SERVER_SCHEME=http

# Deep link (mobile)
APP_SCHEME=pocketwardrobe
APP_HOST=share

# External services — localhost ports exposed by docker-compose.local.yml
REMOVE_BG_SERVICE_URL=http://localhost:8000/
ANALYSIS_SERVICE_URL=http://localhost:8088/
LOOK_GENERATION_SERVICE_URL=http://localhost:8001

# File storage
UPLOADS_DIRECTORY=uploads
LOOKS_DIRECTORY=looks

# CORS — allow everything locally
CORS_ALLOWED_ORIGINS=*

# Rate limits (relaxed for development)
RATE_LIMIT_AUTH=100
RATE_LIMIT_UPLOAD=100
RATE_LIMIT_DEFAULT=500

# DB pool (minimal for local)
DB_POOL_SIZE=5
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# Upload validation
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/jpg

# Logging — verbose locally
LOG_LEVEL=DEBUG

# SMTP — disabled locally (leave blank or use Mailtrap)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
