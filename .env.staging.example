# =============================================================================
# PocketWardrobe — Staging Environment
# =============================================================================
# Copy to .env.staging on the server. Use different secrets from production!
# Deploy: docker-compose -f docker-compose.staging.yml --env-file .env.staging up -d

# JWT — different from prod, still 32+ chars
JWT_SECRET=staging-jwt-secret-change-me-minimum-32-chars
JWT_ISSUER=http://194.87.190.248:8082
JWT_AUDIENCE=pocketwardrobe-users

# Database — pointing to postgres_staging container
DB_URL=jdbc:postgresql://postgres_staging:5432
DB_DRIVER=org.postgresql.Driver
DB_USER=postgres
DB_PASSWORD=postgres1
DB_NAME=wardrobe_staging

# Server
SERVER_HOST=194.87.190.248
SERVER_PORT=8082
SERVER_SCHEME=http

# Deep link
APP_SCHEME=pocketwardrobe
APP_HOST=share

# External services (staging containers)
REMOVE_BG_SERVICE_URL=http://removebg_staging:8000/
ANALYSIS_SERVICE_URL=http://ai_analyzer_staging:8088/
LOOK_GENERATION_SERVICE_URL=http://recommendation_staging:8001

# File storage
UPLOADS_DIRECTORY=uploads
LOOKS_DIRECTORY=looks

# CORS — allow all for staging
CORS_ALLOWED_ORIGINS=*

# Rate limits (relaxed for QA testing)
RATE_LIMIT_AUTH=50
RATE_LIMIT_UPLOAD=50
RATE_LIMIT_DEFAULT=200

# DB pool
DB_POOL_SIZE=5
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# Upload validation
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/jpg

# Logging — verbose for QA
LOG_LEVEL=DEBUG

# SMTP — reuse prod credentials or disable
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@clothis.tech
SMTP_PASSWORD=your_gmail_app_password_16_chars
SMTP_FROM=PocketWardrobe Staging <noreply@clothis.tech>
